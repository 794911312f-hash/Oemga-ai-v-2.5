# Server Runtime Configuration
PORT=3000
NODE_ENV=production

# GEMINI_API_KEY: Required for Gemini AI & Gemini Neural TTS calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Admin Service Account Credentials (JSON string for Cloud Run / VPS)
# Obtain from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"lunar-storm-pwjkk","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@lunar-storm-pwjkk.iam.gserviceaccount.com"}'

# Queue & Task Authentication Secret (Optional)
OMEGA_QUEUE_SECRET="your-queue-secret-key"

# External AI Server Integrations for Omega Multi-Model Consensus:
OPENROUTER_API_KEY=
GROQ_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
OLLAMA_BASE_URL=

# Omega Voice Manager Providers (ElevenLabs, OpenAI TTS, Cartesia, Kokoro, XTTS v2, PlayHT):
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
KOKORO_API_URL="http://localhost:8880/v1/audio/speech"
KOKORO_API_KEY=
XTTS_API_URL="http://localhost:8020"
PLAYHT_API_KEY=
PLAYHT_USER_ID=

# APP_URL: The URL where this applet is hosted.
APP_URL="https://your-domain.com"
