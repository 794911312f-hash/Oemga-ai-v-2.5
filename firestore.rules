rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /omega_evolution/{userId} {
      allow read, write: if true;
    }
    match /omega_experiences/{id} {
      allow read, write: if true;
    }
    match /omega_memory/{id} {
      allow read, write: if true;
    }
  }
}
